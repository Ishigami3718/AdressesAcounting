<Window x:Class="AdressAccounting.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdressAccounting"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <DockPanel>
            <Menu DockPanel.Dock="Left">
                <MenuItem Header="Адреси" Tag="UI/AdressFrame.xaml"/>
                <MenuItem Header="Вулиці" Tag="UI/StreetFrame.xaml"/>
                <MenuItem Header="Злиття вулиць" Tag="UI/MergeFrame.xaml"/>
                <MenuItem Header="Розщеплення вулиць" Tag="UI/SplitFrame.xaml"/>
            </Menu>
        </DockPanel>
        <Frame Name="MainFrame" NavigationUIVisibility="Hidden" />
    </Grid>
</Window>
