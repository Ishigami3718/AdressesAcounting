<Window x:Class="AdressAccounting.UI.AdressCRWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdressAccounting.UI"
        mc:Ignorable="d"
        Title="AdressCRWindow" Height="250" Width="200">
    <Grid>
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.3*"/>
                    <ColumnDefinition Width="0.7*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Номер" Margin="5" Grid.Column="0"/>
                <TextBox Name="NumberTextBox" Margin="5" Grid.Column="1" Text="{Binding Number, 
                    UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNumberValid}" Value="False">
                                    <Setter Property="BorderBrush" Value="Red"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>
            <TextBlock Text="{Binding NumberValidationMessage}" HorizontalAlignment="Right">
                <Run Foreground="Red"/>
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNumberValid}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.3*"/>
                    <ColumnDefinition Width="0.7*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Вулиця" Margin="5" Grid.Column="0"/>
                <ComboBox  Margin="5" Grid.Column="1" 
                           ItemsSource="{Binding Streets}" SelectedItem="{Binding SelectedStreet}" DisplayMemberPath="Name">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStreetValid, UpdateSourceTrigger=PropertyChanged}" Value="False">
                                    <Setter Property="BorderBrush" Value="Red"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
            </Grid>
            <CheckBox Content="Актуальна" Margin="5" IsChecked="{Binding IsActual}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.3*"/>
                    <ColumnDefinition Width="0.7*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Від дати" Margin="5" Grid.Column="0"/>
                <DatePicker Name="DatePickerFrom" Margin="5" Grid.Column="1"
                            SelectedDate="{Binding SelectedDateFrom, UpdateSourceTrigger=PropertyChanged}">
                    <DatePicker.Style>
                        <Style TargetType="DatePicker">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDateFromValid, 
                                    UpdateSourceTrigger=PropertyChanged}" Value="False">
                                    <Setter Property="BorderBrush" Value="Red"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DatePicker.Style>
                </DatePicker>
            </Grid>
            <Button Content="Додати адресу" Margin="5" Click="Button_Click"/>
        </StackPanel>
    </Grid>
</Window>
