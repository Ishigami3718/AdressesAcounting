<Page x:Class="AdressAccounting.UI.AdressFrame"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AdressAccounting.UI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdressFrame">

    <Grid>
        <DockPanel>
            <ToolBarTray DockPanel.Dock="Top" Orientation="Horizontal">
                <ToolBar>
                    <Button Name="AddButton" Content="Додати" />
                    <Button Name="EditButton" Content="Редагувати" />
                    <Button Name="DeleteButton" Content="Видалити" />
                </ToolBar>
            </ToolBarTray>
            <Grid DockPanel.Dock="Left" Width="200">
                <StackPanel HorizontalAlignment="Center" Width="100">
                    <ComboBox Name="StreetComboBox" Margin="5" ItemsSource="{Binding Streets}" 
                              SelectedItem="{Binding SelectedStreetFilter}" DisplayMemberPath="Name"/>
                    <TextBox Name="SearchTextBox" Margin="5" Text="{Binding SearchText}"/>
                    <CheckBox Name="ActualCheckBox" Content="Актуальні" Margin="5" IsChecked="{Binding IsActualFilter}"/>
                    <CheckBox Name="HasHistory" Content="Має історію змін" Margin="5" IsChecked="{Binding IsHasHistoryFilter}"/>
                    <DatePicker Name="HistoryDatePickerFrom" Margin="5" IsEnabled="False" Text="Від"/>
                    <DatePicker Name="HistoryDatePickerTo" Margin="5" IsEnabled="False" Text="До"/>
                </StackPanel>
            </Grid>
            <DataGrid Name="AdressDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" Margin="5" ItemsSource="{Binding Adresses}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Адреса" Binding="{Binding Number}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Вулиця" Binding="{Binding Street.Name}" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</Page>
