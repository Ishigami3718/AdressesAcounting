<Window x:Class="AdressAccounting.UI.StreetDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdressAccounting.UI"
        mc:Ignorable="d"
        Title="{Binding Street.Name}" Height="450" Width="800">
    
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <GroupBox Header="Історичні назви" Grid.ColumnSpan="2">
            <DataGrid AutoGenerateColumns="False" 
              CanUserAddRows="False" CanUserDeleteRows="False"
              CanUserResizeRows="False" CanUserReorderColumns="False"
              IsReadOnly="True" SelectionMode="Single"
              Margin="5" ItemsSource="{Binding HistoricalNames}"
              SelectionUnit="FullRow" CanUserSortColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="0.1*"/>
                    <DataGridTextColumn Header="Назва" Binding="{Binding Name}" Width="0.3*"/>
                    <DataGridTextColumn Header="Дата початку" Width="0.3*"
                                        Binding="{Binding StartDate, StringFormat=0:{dd.MM.yyyy}}"/>
                    <DataGridTextColumn Header="Дата кінця" Width="0.3*"
                                        Binding="{Binding EndDate, StringFormat=0:{dd.MM.yyyy}}"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        <GroupBox Header="Батьківсткі вулиці" Grid.Row="1">
            <DataGrid AutoGenerateColumns="False" 
  CanUserAddRows="False" CanUserDeleteRows="False"
  CanUserResizeRows="False" CanUserReorderColumns="False"
  IsReadOnly="True" SelectionMode="Single"
  Margin="5" ItemsSource="{Binding ParentStreets}"
  SelectionUnit="FullRow" CanUserSortColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="0.1*"/>
                    <DataGridTextColumn Header="Назва вулиці" Binding="{Binding Name}" Width="0.5*"/>
                    <DataGridTextColumn Header="Дата" Width="0.4*"
                            Binding="{Binding StartDate, StringFormat=0:{dd.MM.yyyy}}"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        <GroupBox Header="Дочірні вулиці" Grid.Row="1" Grid.Column="1">
            <DataGrid AutoGenerateColumns="False" 
  CanUserAddRows="False" CanUserDeleteRows="False"
  CanUserResizeRows="False" CanUserReorderColumns="False"
  IsReadOnly="True" SelectionMode="Single"
  Margin="5" ItemsSource="{Binding ChildStreets}"
  SelectionUnit="FullRow" CanUserSortColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="0.1*"/>
                    <DataGridTextColumn Header="Назва" Binding="{Binding Name}" Width="0.5*"/>
                    <DataGridTextColumn Header="Дата початку" Width="0.4*"
                            Binding="{Binding StartDate, StringFormat=0:{dd.MM.yyyy}}"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</Window>
